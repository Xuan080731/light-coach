<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ dark-mode splash, matched to the app's dark surface. -->
    <style name="LaunchTheme" parent="@style/Theme.SplashScreen">
        <!-- Android 12's dark dynamic neutral color follows the current wallpaper. -->
        <item name="windowSplashScreenBackground">@android:color/system_neutral1_900</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
        <item name="android:statusBarColor">@android:color/system_neutral1_900</item>
        <item name="android:navigationBarColor">@android:color/system_neutral1_900</item>
    </style>
</resources>
