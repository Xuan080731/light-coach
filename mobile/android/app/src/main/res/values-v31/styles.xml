<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: the platform animates the adaptive app icon. -->
    <style name="LaunchTheme" parent="@style/Theme.SplashScreen">
        <!-- Android 12's dynamic neutral color follows the current wallpaper. -->
        <item name="windowSplashScreenBackground">@android:color/system_neutral1_10</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/system_neutral1_10</item>
        <item name="android:navigationBarColor">@android:color/system_neutral1_10</item>
    </style>
</resources>
