<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ dark-mode splash, matched to the app's dark surface. -->
    <style name="LaunchTheme" parent="@style/Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launch_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/NormalTheme</item>
        <item name="android:statusBarColor">@color/launch_background</item>
        <item name="android:navigationBarColor">@color/launch_background</item>
    </style>
</resources>
